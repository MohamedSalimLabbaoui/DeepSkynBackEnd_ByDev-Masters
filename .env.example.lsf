# ============================================================================
# Sign Language Translation (LSF) Configuration
# ============================================================================

# URL du microservice Python FastAPI
SIGN_TRANSLATION_SERVICE_URL=http://localhost:8000

# Langues supportées (ISO 639-1)
SUPPORTED_LANGUAGES=fr,en

# Timeout pour les appels au microservice (en ms)
TRANSLATION_SERVICE_TIMEOUT=30000

# Nombre de tentatives en cas d'erreur
TRANSLATION_MAX_RETRIES=3

# Délai entre les retries (en ms)
TRANSLATION_RETRY_DELAY=1000

# ============================================================================
# Optional: Cache Configuration (si cache est activé)
# ============================================================================

# Redis URL (optionnel)
# REDIS_URL=redis://localhost:6379

# TTL du cache en secondes (24 heures)
# CACHE_TTL=86400

# Nombre max d'entrées en cache
# CACHE_MAX_ENTRIES=1000

# ============================================================================
# Optional: Rate Limiting (si throttler est activé)
# ============================================================================

# Requêtes par minute par IP
# RATE_LIMIT_TRANSLATIONS=100

# ============================================================================
# Monitoring & Logging (optionnel)
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Activer Prometheus metrics
# ENABLE_PROMETHEUS=false

# ============================================================================
# Application Configuration
# ============================================================================

# Port du serveur NestJS
PORT=3001

# Node environment
NODE_ENV=development

# ============================================================================
# AI Configuration (Gemini -> OpenRouter -> Groq fallback)
# ============================================================================

# Vertex AI (first stage: model + key rotation)
VERTEX_PRIMARY_MODEL=gemini-2.5-pro
VERTEX_FALLBACK_MODEL=gemini-2.0-flash
VERTEX_API_KEY=your_vertex_api_key_here
VERTEX_API_KEY_2=your_second_vertex_api_key_here
VERTEX_API_KEY_3=your_third_vertex_api_key_here

# Gemini (primary + fallback model + key rotation)
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# OpenRouter (vision + text fallback, with key rotation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_KEY_2=your_second_openrouter_api_key_here
OPENROUTER_API_KEY_3=your_third_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Groq (text fallback after OpenRouter)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_API_KEY_3=your_third_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
